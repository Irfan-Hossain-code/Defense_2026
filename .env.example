# ── ConfidentialMind (event narration + vision profile) ──
CONFIDENTIALMIND_BASE_URL=https://api.poc.confmind-dev.com/v1/api/YOUR_ENDPOINT_ID
CONFIDENTIALMIND_API_KEY=your_confidentialmind_key
CM_MODEL_NARRATION=Gemma 4
CM_MODEL_VISION=Qwen3-Omni-30B-A3B-Thinking

# ── Google Gemini (voice Q&A when operator talks) ──
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# ── Profiles (dossier text) ──
# PROFILE_DB_PATH=data/profiles
# DOSSIER_MIN_CONFIDENCE=0.55
# SUBTITLE_HOLD_SEC=6
# USE_LLM_NARRATION=0
# SQUAD_AUTO_NARRATE=0

# ── Speech (macOS `say` — narrator + PTT replies) ──
# SAY_VOICE=Samantha
# SAY_RATE=175
# TTS_MIN_GAP_SEC=2.5

# ── LiveKit Cloud (optional — audio in React HUD) ──
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=defense-tactical

# ── Bridge ──
WS_HOST=127.0.0.1
WS_PORT=8765

# ── Session data ──
TARGET_SESSION_PATH=data/target_session.json
